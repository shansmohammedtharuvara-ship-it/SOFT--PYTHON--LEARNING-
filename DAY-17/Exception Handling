# PYTHON UNPACKING


# QUESTION 1
# Unpack countries from the list

names = ['Finland', 'Sweden', 'Norway', 'Denmark',
         'Iceland', 'Estonia', 'Russia']


# Unpack the first five countries and the last two

*nordic_countries, es, ru = names


# Print the Nordic countries

print("Nordic Countries:", nordic_countries)


# Print Estonia

print("Estonia:", es)


# Print Russia

print("Russia:", ru)