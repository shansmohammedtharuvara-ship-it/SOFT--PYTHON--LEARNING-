# QUESTION 2
# Find the most spoken languages

def most_spoken_languages(filename, number):

    with open(filename, 'r', encoding='utf-8') as file:
        countries = json.load(file)

    languages = {}

    for country in countries:
        for language in country['languages']:

            if language in languages:
                languages[language] += 1
            else:
                languages[language] = 1

    result = []

    for language, count in languages.items():
        result.append((count, language))

    result.sort(reverse=True)

    return result[:number]


print("Most spoken languages:")

print(most_spoken_languages(
    './data/countries_data.json', 10
))

print(most_spoken_languages(
    './data/countries_data.json', 3
))


# QUESTION 3
# Find the most populated countries

def most_populated_countries(filename, number):

    with open(filename, 'r', encoding='utf-8') as file:
        countries = json.load(file)

    result = []

    for country in countries:

        info = {
            'country': country['name'],
            'population': country['population']
        }

        result.append(info)

    result.sort(
        key=lambda x: x['population'],
        reverse=True
    )

    return result[:number]


print("Most populated countries:")

print(most_populated_countries(
    './data/countries_data.json', 10
))

