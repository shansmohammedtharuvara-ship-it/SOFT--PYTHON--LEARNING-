# QUESTION 6
# Read Hacker News CSV file


def count_hacker_news(filename):

    python_count = 0
    javascript_count = 0
    java_count = 0

    with open(filename, 'r', encoding='utf-8') as file:

        reader = csv.reader(file)

        for row in reader:

            text = ' '.join(row)

            if re.search(r'python', text, re.I):
                python_count += 1

            if re.search(r'javascript', text, re.I):
                javascript_count += 1

            if re.search(r'\bjava\b', text, re.I):
                java_count += 1

    print("Python lines:", python_count)

    print("JavaScript lines:", javascript_count)

    print("Java lines:", java_count)


count_hacker_news('./data/hacker_news.csv')