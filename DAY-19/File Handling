# QUESTION 4
# Check similarity between two speeches


# Clean the text

def clean_text(text):

    text = text.lower()

    text = re.sub(r'[^a-zA-Z ]', ' ', text)

    return text


# Remove stop words

def remove_support_words(text):

    with open('./data/stop_words.py', 'r', encoding='utf-8') as file:
        stop_text = file.read()

    # Extract the stop words list from the Python file
    import ast

    tree = ast.parse(stop_text)
    stop_words = []

    for node in tree.body:
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name) and target.id == 'stop_words':
                    stop_words = ast.literal_eval(node.value)

    words = text.split()

    result = []

    for word in words:

        if word not in stop_words:
            result.append(word)

    return result


# Compare two texts

def check_text_similarity(file1, file2):

    with open(file1, 'r', encoding='utf-8') as file:
        text1 = file.read()

    with open(file2, 'r', encoding='utf-8') as file:
        text2 = file.read()

    text1 = clean_text(text1)
    text2 = clean_text(text2)

    words1 = set(remove_support_words(text1))
    words2 = set(remove_support_words(text2))

    common_words = words1.intersection(words2)

    all_words = words1.union(words2)

    if len(all_words) == 0:
        return 0

    similarity = len(common_words) / len(all_words)

    return similarity * 100


print("Speech similarity:")

similarity = check_text_similarity(
    './data/michelle_obama_speech.txt',
    './data/melina_trump_speech.txt'
)

print("Similarity:", round(similarity, 2), "%")


