# Empty list
empty_list = list()
print(len(empty_list))  # 0


# List of cars
cars = ['BMW', 'Toyota', 'Honda', 'Ford']

bikes = ['Yamaha', 'Honda', 'Kawasaki', 'Suzuki', 'Ducati']

mobile_brands = ['Apple', 'Samsung', 'Google', 'OnePlus']

programming_languages = ['Python', 'Java', 'C++', 'JavaScript', 'Go']

countries = ['India', 'Japan', 'Germany', 'Canada', 'Australia']


# Print the lists and their length
print('Cars:', cars)
print('Number of cars:', len(cars))

print('Bikes:', bikes)
print('Number of bikes:', len(bikes))

print('Mobile brands:', mobile_brands)
print('Number of mobile brands:', len(mobile_brands))

print('Programming languages:', programming_languages)
print('Number of programming languages:', len(programming_languages))

print('Number of countries:', len(countries))


# Modifying list

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

first_car = cars[0]
print(first_car)  # BMW

second_car = cars[1]
print(second_car)  # Toyota

last_car = cars[3]
print(last_car)  # Ford


# Last index
last_index = len(cars) - 1
last_car = cars[last_index]
print(last_car)


# Accessing items

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

last_car = cars[-1]
second_last_car = cars[-2]

print(last_car)         # Ford
print(second_last_car)  # Honda


# Slicing items

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

all_cars = cars[0:4]
print(all_cars)

all_cars = cars[0:]
print(all_cars)

toyota_and_honda = cars[1:3]
print(toyota_and_honda)

toyota_honda_ford = cars[1:]
print(toyota_honda_ford)


# Negative slicing

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

all_cars = cars[-4:]
print(all_cars)

toyota_and_honda = cars[-3:-1]
print(toyota_and_honda)

toyota_honda_ford = cars[-3:]
print(toyota_honda_ford)


# Changing items

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

cars[0] = 'Audi'
print(cars)

cars[1] = 'Mercedes'
print(cars)

last_index = len(cars) - 1
cars[last_index] = 'Tesla'
print(cars)


# Checking items

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

does_exist = 'BMW' in cars
print(does_exist)  # True

does_exist = 'Tesla' in cars
print(does_exist)  # False


# Append

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

cars.append('Audi')
print(cars)

cars.append('Tesla')
print(cars)


# Insert

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

cars.insert(2, 'Audi')
print(cars)

# Insert Tesla at index 3
cars.insert(3, 'Tesla')
print(cars)


# Remove

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

cars.remove('BMW')
print(cars)

cars.remove('Ford')
print(cars)


# Pop

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

cars.pop()
print(cars)  # Removes last item

cars.pop(0)
print(cars)  # Removes first item


# del

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

del cars[0]
print(cars)

del cars[1]
print(cars)

# Delete the complete list
del cars

