# Clear

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

cars.clear()
print(cars)  # []


# Copying a list

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

cars_copy = cars.copy()

print(cars_copy)


# Joining lists

small_numbers = [1, 2, 3, 4, 5]
zero = [0]
negative_numbers = [-5, -4, -3, -2, -1]

numbers = negative_numbers + zero + small_numbers

print(numbers)


cars = ['BMW', 'Toyota', 'Honda']
bikes = ['Yamaha', 'Suzuki', 'Ducati']

cars_and_bikes = cars + bikes

print(cars_and_bikes)


# Join with extend

num1 = [0, 1, 2, 3]
num2 = [4, 5, 6]

num1.extend(num2)

print('Numbers:', num1)


negative_numbers = [-5, -4, -3, -2, -1]
positive_numbers = [1, 2, 3, 4, 5]
zero = [0]

negative_numbers.extend(zero)
negative_numbers.extend(positive_numbers)

print('Integers:', negative_numbers)


cars = ['BMW', 'Toyota', 'Honda']
bikes = ['Yamaha', 'Suzuki', 'Ducati']

cars.extend(bikes)

print('Cars and bikes:', cars)


# Count

cars = ['BMW', 'Toyota', 'Honda', 'BMW']

print(cars.count('BMW'))  # 2

ages = [22, 19, 24, 25, 26, 24, 25, 24]

print(ages.count(24))  # 3


# Index

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

print(cars.index('Toyota'))  # 1

ages = [22, 19, 24, 25, 26, 24, 25, 24]

print(ages.index(24))  # 2


# Reverse

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

cars.reverse()

print(cars)


ages = [22, 19, 24, 25, 26, 24, 25, 24]

ages.reverse()

print(ages)


# Sort

cars = ['BMW', 'Toyota', 'Honda', 'Ford']

cars.sort()

print(cars)

cars.sort(reverse=True)

print(cars)


