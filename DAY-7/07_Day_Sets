# 1. Convert ages to a set
ages = [18, 20, 19, 18, 21, 20, 22, 19]

ages_set = set(ages)

print('Ages list:', ages)
print('Ages set:', ages_set)
print('Length of ages list:', len(ages))
print('Length of ages set:', len(ages_set))

if len(ages) > len(ages_set):
    print('The list is bigger.')
elif len(ages) < len(ages_set):
    print('The set is bigger.')
else:
    print('Both have the same length.')


