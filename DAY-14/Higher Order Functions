# QUESTION 8
# Chain map, filter and reduce

def double(num):
    return num * 2

def greater_than_ten(num):
    return num > 10

def add(a, b):
    return a + b

mapped = map(double, numbers)

filtered = filter(greater_than_ten, mapped)

result = reduce(add, filtered)

print(result)


