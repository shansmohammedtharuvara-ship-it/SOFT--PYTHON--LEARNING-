# QUESTION 2
# Find ten most spoken languages by number of countries

language_count = {}

for country in countries_data:
    for language in country['languages']:

        if language in language_count:
            language_count[language] += 1
        else:
            language_count[language] = 1


def get_language_count(item):
    return item[1]


sorted_languages = sorted(
    language_count.items(),
    key=get_language_count,
    reverse=True
)

print("Ten most spoken languages:")

for language in sorted_languages[:10]:
    print(language)


