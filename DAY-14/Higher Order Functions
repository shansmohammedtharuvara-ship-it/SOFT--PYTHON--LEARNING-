# QUESTION 12
# Categorize countries based on patterns

def categorize_countries(country_list, pattern):
    result = []

    for country in country_list:
        if pattern.lower() in country.lower():
            result.append(country)

    return result


print(categorize_countries(countries, 'land'))
print(categorize_countries(countries, 'ia'))


# QUESTION 13
# Count countries by starting letter

def count_countries(country_list):
    result = {}

    for country in country_list:
        letter = country[0]

        if letter in result:
            result[letter] += 1
        else:
            result[letter] = 1

    return result


print(count_countries(countries))


