    # Level 3 - Person Dictionary

person = {
    "first_name": "Rahul",
    "last_name": "Kumar",
    "age": 24,
    "country": "Finland",
    "is_married": True,
    "skills": ["JavaScript", "React", "Node", "MongoDB", "Python"],
    "address": {
        "street": "Green Street",
        "zipcode": "02210"
    }
}


# 1. Check if the person has skills
if "skills" in person:
    skills = person["skills"]
    middle_skill = skills[len(skills) // 2]
    print("Middle skill:", middle_skill)


# 2. Check if the person has Python skill
if "skills" in person:
    if "Python" in person["skills"]:
        print("The person has Python skill.")
    else:
        print("The person does not have Python skill.")


# 3. Check the type of developer

skills = person["skills"]

if "JavaScript" in skills and "React" in skills and len(skills) == 2:
    print("He is a front end developer.")

elif "Node" in skills and "Python" in skills and "MongoDB" in skills:
    print("He is a backend developer.")

elif "React" in skills and "Node" in skills and "MongoDB" in skills:
    print("He is a fullstack developer.")

else:
    print("Unknown title.")


# 4. Check if the person is married and lives in Finland

if person["is_married"] and person["country"] == "Finland":
    print(
        f"{person['first_name']} {person['last_name']} "
        f"lives in {person['country']}. He is married."
    )