# LIST COMPREHENSION AND LAMBDA FUNCTIONS


# QUESTION 1
# Filter negative numbers and zero

numbers = [-4, -3, -2, -1, 0, 2, 4, 6]

result = [i for i in numbers if i <= 0]

print(result)


# QUESTION 2
# Flatten a list of lists

list_of_lists = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]

result = [num for row in list_of_lists for num in row]

print(result)


# QUESTION 3
# Create a list of tuples using list comprehension

result = [(i, 1, i, i**2, i**3, i**4, i**5) for i in range(11)]

print(result)


# QUESTION 4
# Change countries into a new list

countries = [[('Finland', 'Helsinki')],
             [('Sweden', 'Stockholm')],
             [('Norway', 'Oslo')]]

result = [[country.upper(), country[:3].upper(), city.upper()]
          for row in countries
          for country, city in row]

print(result)


# QUESTION 5
# Change countries into dictionaries

countries = [[('Finland', 'Helsinki')],
             [('Sweden', 'Stockholm')],
             [('Norway', 'Oslo')]]

result = [{'country': country.upper(), 'city': city.upper()}
          for row in countries
          for country, city in row]

print(result)


# QUESTION 6
# Join first name and last name

names = [[('Asabeneh', 'Yetayeh')],
         [('David', 'Smith')],
         [('Donald', 'Trump')],
         [('Bill', 'Gates')]]

result = [first + " " + last
          for row in names
          for first, last in row]

print(result)


# QUESTION 7
# Lambda function to calculate slope

slope = lambda x1, y1, x2, y2: (y2 - y1) / (x2 - x1)

print(slope(2, 3, 4, 7))


# Lambda function to calculate y-intercept

y_intercept = lambda x, y, m: y - m * x

print(y_intercept(2, 3, 2))