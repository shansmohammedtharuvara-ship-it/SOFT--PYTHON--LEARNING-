# Read countries API

countries_api = 'https://restcountries.com/v3.1/all?fields=name,area,languages'

response = requests.get(countries_api)

countries = response.json()


# QUESTION 3A
# Find 10 largest countries

def get_area(country):
    return country['area']


largest_countries = sorted(
    countries,
    key=get_area,
    reverse=True
)


print("10 LARGEST COUNTRIES")

for country in largest_countries[:10]:

    print(
        country['name']['common'],
        country['area']
    )


# QUESTION 3B
# Find 10 most spoken languages

language_count = {}

for country in countries:

    if 'languages' in country:

        for language in country['languages'].values():

            if language in language_count:
                language_count[language] += 1
            else:
                language_count[language] = 1


def get_count(item):
    return item[1]


sorted_languages = sorted(
    language_count.items(),
    key=get_count,
    reverse=True
)


print("10 MOST SPOKEN LANGUAGES")

for language in sorted_languages[:10]:
    print(language)


# QUESTION 3C
# Find total number of languages

total_languages = len(language_count)

print("Total number of languages:", total_languages)


